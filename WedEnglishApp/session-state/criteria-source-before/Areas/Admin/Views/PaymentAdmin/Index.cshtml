@model List<WedEnglishApp.Models.Payment>
@{
    ViewData["Title"] = "Quản Lý Thanh Toán";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản Lý Thanh Toán Học Phí</h3>
        <p class="text-muted small mb-0">Xác nhận các khoản thu học phí, kiểm tra mã giao dịch ngân hàng / ví điện tử</p>
    </div>
</div>

<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã HĐ</th>
                    <th>Học Viên</th>
                    <th>Lớp Học</th>
                    <th>Số Tiền</th>
                    <th>Phương Thức</th>
                    <th>Mã Giao Dịch</th>
                    <th>Ngày Thu</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">#PAY-@p.PaymentId</td>
                        <td>
                            <div class="fw-bold">@p.Registration.Student.UserAccount.FullName</div>
                            <div class="small text-muted">@p.Registration.Student.UserAccount.Email</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@(p.Registration.Class?.ClassName ?? "Chờ xếp lớp")</div>
                            <div class="small text-muted">@p.Registration.Program.ProgramName</div>
                        </td>
                        <td class="fw-bold text-danger">@p.Amount.ToString("N0") đ</td>
                        <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                        <td><code>@(p.TransactionCode ?? "---")</code></td>
                        <td class="small text-muted">@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(p.Status == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                @(p.Status == "Paid" ? "Đã thu tiền" : "Chờ thu tiền")
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            @if (p.Status != "Paid")
                            {
                                <form asp-action="ConfirmPayment" asp-route-id="@p.PaymentId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                        <i class="fa-solid fa-check me-1"></i> Xác Nhận Thu
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-success small fw-bold"><i class="fa-solid fa-circle-check"></i> Đã hoàn tất</span>
                            }
                            <a asp-action="PrintReceipt" asp-route-id="@p.PaymentId" target="_blank" class="btn btn-sm btn-outline-primary ms-1" title="In Hóa Đơn">
                                <i class="fa-solid fa-print"></i> In HĐ
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
