@model WedEnglishApp.Models.Student
@{
    ViewData["Title"] = "Đăng Ký Thi Xếp Lớp";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Form Đăng ký lịch thi mới -->
        <div class="col-lg-5">
            <div class="card card-custom p-4 border-0 bg-white">
                <h4 class="fw-bold text-primary mb-3">
                    <i class="fa-solid fa-calendar-check me-2"></i> Đăng Ký Kiểm Tra Xếp Lớp
                </h4>
                <p class="text-muted small">
                    Gửi ngày và giờ mong muốn. Admin sẽ xếp bạn vào lớp thi, thông báo phòng thi, lịch chính thức và giáo viên chấm bài.
                </p>

                <form asp-action="BookTest" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học viên</label>
                        <input type="text" class="form-control bg-light" value="@(Model?.UserAccount?.FullName ?? "Học viên")" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày thi mong muốn <span class="text-danger">*</span></label>
                        <input type="date" name="testDate" class="form-control" value="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Khung giờ mong muốn <span class="text-danger">*</span></label>
                        <select name="testTime" class="form-select" required>
                            <option value="08:30 AM">08:30 AM (Buổi sáng)</option>
                            <option value="10:00 AM">10:00 AM (Buổi sáng)</option>
                            <option value="02:00 PM">02:00 PM (Buổi chiều)</option>
                            <option value="04:00 PM">04:00 PM (Buổi chiều)</option>
                            <option value="06:30 PM">06:30 PM (Buổi tối)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi đăng ký thi xếp lớp
                    </button>
                </form>
            </div>
        </div>

        <!-- Lịch sử bài test đã đăng ký -->
        <div class="col-lg-7">
            <div class="card card-custom p-4 border-0 bg-white">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i> Lịch Sử Kiểm Tra Trình Độ</h4>

                @if (!Model.PlacementTests.Any())
                {
                    <div class="alert alert-info">Bạn chưa có bài kiểm tra xếp lớp nào. Hãy đăng ký lịch thi ở form bên cạnh.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Test</th>
                                    <th>Thời Gian Thi</th>
                                    <th>Điểm Đạt</th>
                                    <th>Trình Độ Đề Xuất</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pt in Model.PlacementTests.OrderByDescending(t => t.TestDate))
                                {
                                    <tr>
                                        <td class="fw-bold">#TEST-@pt.TestId</td>
                                        <td>
                                            @if (pt.ExamSession != null) {
                                                <strong>@pt.ExamSession.Name</strong><div>@pt.ExamSession.Room</div>
                                                <div>@pt.TestDate.ToString("dd/MM/yyyy") · @pt.TestTime</div>
                                                <small>@(pt.EvaluatedByTeacher?.UserAccount.FullName ?? "Chưa phân công giáo viên chấm")</small>
                                            } else {
                                                <div>Ngày mong muốn: @((pt.RequestedDate ?? pt.TestDate).ToString("dd/MM/yyyy"))</div><small>@(pt.RequestedTime ?? pt.TestTime)</small>
                                            }
                                        </td>
                                        <td>
                                            @if (pt.Score.HasValue)
                                            {
                                                <span class="fw-bold text-success fs-6">@pt.Score.Value.ToString("0.0") / 10</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa có điểm</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(pt.RecommendedLevel))
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    @pt.RecommendedLevel
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@(pt.ExamSessionId == null ? "Chờ xếp phòng thi" : "Chưa có đề xuất")</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(pt.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                                @(pt.Status == "Completed" ? "Hoàn thành" : pt.ExamSessionId == null ? "Chờ Admin xếp phòng thi" : "Đã xếp phòng / Chờ chấm")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
