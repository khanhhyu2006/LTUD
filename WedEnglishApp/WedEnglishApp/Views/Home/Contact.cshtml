@model WedEnglishApp.ViewModels.Consultations.StartConsultationViewModel
@{
    ViewData["Title"] = "Liên Hệ & Tư Vấn";
}

<div class="container py-5">
    <div class="row g-4 g-lg-5">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">Trung tâm ngoại ngữ @WedEnglishApp.Services.SiteBrand.Name</h2>
            <p class="lead text-muted mb-4">
                Nếu bạn có bất kỳ thắc mắc nào về lộ trình kiểm tra xếp lớp, thời khóa biểu hoặc học phí các khóa học, vui lòng liên hệ với chúng tôi.
            </p>

            <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Địa chỉ trung tâm</h6>
                        <span class="text-muted small">20 Tăng Nhơn Phú, P. Phước Long B, TP. Thủ Đức, TP.HCM</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Hotline tư vấn</h6>
                        <span class="text-muted small">028 3731 2370 - 0909 123 456</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="bg-info text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Email phòng đào tạo</h6>
                        <span class="text-muted small">@WedEnglishApp.Services.SiteBrand.AdmissionsEmail</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card card-custom p-4 border-0 bg-white">
                <h4 class="fw-bold text-primary mb-3"><i class="fa-solid fa-paper-plane me-2"></i> Trao đổi trực tiếp với Admin</h4>
                <p class="small text-muted">Gửi lời nhắn đầu tiên để mở cuộc tư vấn. Bạn có thể xem phản hồi và nhắn tiếp ngay trên website.</p>
                <a asp-controller="Consultation" asp-action="Mine" class="btn btn-outline-primary mb-3">Xem các cuộc tư vấn của tôi</a>
                <form asp-controller="Consultation" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div class="mb-3">
                        <label for="contact-name" class="form-label fw-semibold">Họ và tên của bạn</label>
                        <input asp-for="ContactName" id="contact-name" class="form-control" maxlength="100" readonly="@Model.IsStudent" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="contact-email" class="form-label fw-semibold">Email</label>
                            <input asp-for="ContactEmail" id="contact-email" type="email" class="form-control" maxlength="100" readonly="@Model.IsStudent" required />
                        </div>
                        <div class="col-md-6">
                            <label for="contact-phone" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="PhoneNumber" id="contact-phone" type="tel" class="form-control" maxlength="20" placeholder="0901234567" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="contact-question" class="form-label fw-semibold">Nội dung câu hỏi</label>
                        <textarea asp-for="Question" id="contact-question" rows="4" maxlength="1000" class="form-control" placeholder="Bạn muốn được tư vấn về khóa học, lịch học hay học phí?" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold">
                        Bắt đầu cuộc tư vấn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
