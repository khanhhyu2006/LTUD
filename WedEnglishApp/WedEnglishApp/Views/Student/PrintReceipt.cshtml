@model WedEnglishApp.Models.Payment
@{
    Layout = null; // In độc lập không dính header/footer của web
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Biên Lai Thu Học Phí #PAY-@Model.PaymentId - @WedEnglishApp.Services.SiteBrand.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: #f8fafc;
            color: #000;
        }
        .receipt-container {
            max-width: 800px;
            margin: 30px auto;
            background: #fff;
            padding: 40px;
            border: 2px solid #334155;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .stamp-box {
            border: 2px dashed #dc2626;
            color: #dc2626;
            display: inline-block;
            padding: 8px 16px;
            font-weight: bold;
            border-radius: 6px;
            transform: rotate(-5deg);
        }
        @@media print {
            body { background: #fff; }
            .receipt-container { border: 1px solid #000; box-shadow: none; margin: 0; padding: 20px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold me-2">
            <i class="fa-solid fa-print me-1"></i> In Biên Lai / Lưu PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            Đóng Cửa Sổ
        </button>
    </div>

    <div class="receipt-container">
        <!-- Header -->
        <div class="row align-items-center mb-4 border-bottom pb-3">
            <div class="col-8">
                <h5 class="fw-bold mb-0 text-uppercase">TRƯỜNG CAO ĐẲNG CÔNG THƯƠNG TP.HCM</h5>
                <h6 class="fw-bold text-primary mb-1">Trung tâm ngoại ngữ @WedEnglishApp.Services.SiteBrand.Name</h6>
                <div class="small">Địa chỉ: 20 Tăng Nhơn Phú, P. Phước Long B, TP. Thủ Đức, TP.HCM</div>
                <div class="small">Hotline: 028 3731 2370 | Email: @WedEnglishApp.Services.SiteBrand.ContactEmail</div>
            </div>
            <div class="col-4 text-end">
                <div class="small fw-bold">Mẫu số: 01/BLHP</div>
                <div class="small text-muted">Ký hiệu: @(WedEnglishApp.Services.SiteBrand.ReceiptPrefix)/@DateTime.Now.Year</div>
                <div class="fw-bold text-danger fs-6 mt-1">Số: #PAY-@Model.PaymentId.ToString("D5")</div>
            </div>
        </div>

        <!-- Title -->
        <div class="text-center my-4">
            <h3 class="fw-bold text-uppercase mb-1">BIÊN LAI THU TIỀN HỌC PHÍ</h3>
            <div class="fst-italic small">Ngày thu: @(Model.ConfirmedAt ?? Model.PaymentDate).ToString("dd") tháng @(Model.ConfirmedAt ?? Model.PaymentDate).ToString("MM") năm @(Model.ConfirmedAt ?? Model.PaymentDate).ToString("yyyy")</div>
        </div>

        <!-- Student Info -->
        <div class="mb-4">
            <div class="row mb-2">
                <div class="col-3 fw-bold">Họ tên học viên:</div>
                <div class="col-9 border-bottom border-dark border-dotted">@Model.Registration.Student.UserAccount.FullName</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-bold">Mã số học viên:</div>
                <div class="col-9 border-bottom border-dark border-dotted">#STU-@Model.Registration.Student.StudentId</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-bold">Số điện thoại / Email:</div>
                <div class="col-9 border-bottom border-dark border-dotted">@(Model.Registration.Student.PhoneNumber ?? "---") / @Model.Registration.Student.UserAccount.Email</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-bold">Lớp học đăng ký:</div>
                <div class="col-9 border-bottom border-dark border-dotted"><strong>@(Model.Registration.Class?.ClassName ?? "Chờ xếp lớp")</strong> (Chương trình: @Model.Registration.Program.ProgramName)</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-bold">Hình thức thu:</div>
                <div class="col-9 border-bottom border-dark border-dotted">@Model.PaymentMethod @(!string.IsNullOrEmpty(Model.TransactionCode) ? $" (Mã GD: {Model.TransactionCode})" : "")</div>
            </div>
        </div>

        <!-- Fee Details Table -->
        <table class="table table-bordered border-dark text-center align-middle mb-4">
            <thead class="table-light border-dark">
                <tr>
                    <th style="width: 10%;">STT</th>
                    <th>Nội Dung Khoản Thu</th>
                    <th style="width: 20%;">Thời Lượng</th>
                    <th style="width: 25%;">Số Tiền (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td class="text-start ps-3">Học phí khóa học @Model.Registration.Program.ProgramName</td>
                    <td>@Model.Registration.Program.DurationWeeks tuần</td>
                    <td class="fw-bold">@Model.Amount.ToString("N0")</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end fw-bold pe-3">TỔNG CỘNG TIỀN THANH TOÁN:</td>
                    <td class="fw-bold text-danger fs-5">@Model.Amount.ToString("N0") đ</td>
                </tr>
            </tbody>
        </table>

        <!-- Signatures -->
        <div class="row text-center mt-5">
            <div class="col-6">
                <div class="fw-bold">NGƯỜI NỘP TIỀN</div>
                <div class="small fst-italic">(Ký và ghi rõ họ tên)</div>
                <div style="height: 70px;"></div>
                <div class="fw-semibold">@Model.Registration.Student.UserAccount.FullName</div>
            </div>
            <div class="col-6">
                <div class="fw-bold">NGƯỜI THU TIỀN / THỦ QUỸ</div>
                <div class="small fst-italic">(Ký, đóng dấu điện tử)</div>
                <div style="height: 30px;"></div>
                <div class="stamp-box">
                    <i class="fa-solid fa-stamp me-1"></i> ĐÃ THU TIỀN<br />
                    <span style="font-size: 0.75rem;">@WedEnglishApp.Services.SiteBrand.Name</span>
                </div>
                <div class="fw-semibold mt-2">Phòng Tài Chính Kế Toán</div>
            </div>
        </div>
    </div>
</body>
</html>
