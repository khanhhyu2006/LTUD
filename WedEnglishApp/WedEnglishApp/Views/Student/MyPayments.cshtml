@model List<WedEnglishApp.Models.Payment>
@{
    ViewData["Title"] = "Lịch Sử Học Phí";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i> Lịch Sử Thanh Toán Học Phí</h3>
            <p class="text-muted small mb-0">Tra cứu các hóa đơn thanh toán và biên lai học phí các khóa học</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fa-solid fa-file-invoice-dollar fs-1 mb-3 text-info"></i>
            <h5>Chưa có hóa đơn thanh toán nào!</h5>
        </div>
    }
    else
    {
        <div class="card card-custom border-0 bg-white shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Hóa Đơn</th>
                            <th>Lớp Học / Khóa Học</th>
                            <th>Số Tiền</th>
                            <th>Phương Thức</th>
                            <th>Mã Giao Dịch</th>
                            <th>Ngày Thanh Toán</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#PAY-@p.PaymentId</td>
                                <td>
                                    <div class="fw-semibold">@(p.Registration.Class?.ClassName ?? "Chờ xếp lớp")</div>
                                    <div class="small text-muted">@p.Registration.Program.ProgramName</div>
                                </td>
                                <td class="fw-bold text-danger">@p.Amount.ToString("N0") VNĐ</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        @p.PaymentMethod
                                    </span>
                                </td>
                                <td>
                                    <code>@(p.TransactionCode ?? "---")</code>
                                </td>
                                <td class="small text-muted">@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (p.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                            <i class="fa-solid fa-circle-check me-1"></i> Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">
                                            <i class="fa-solid fa-clock me-1"></i> Chờ xác nhận
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="PrintReceipt" asp-route-id="@p.PaymentId" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
                                        <i class="fa-solid fa-print me-1"></i> In Biên Lai
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
