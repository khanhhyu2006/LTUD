@model List<WedEnglishApp.Models.Registration>
@{
    ViewData["Title"] = "Khóa học và lớp của tôi";
}

<div class="container pt-3"><a href="/Student/Materials" class="btn btn-outline-primary">Tài liệu học tập của tôi</a></div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-chalkboard text-primary me-2"></i> Khóa học và lớp của tôi</h3>
            <p class="text-muted small mb-0">Theo dõi thông tin lớp học, thời khóa biểu và trạng thái đăng ký của bạn</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Schedule" class="btn btn-primary fw-semibold">
                <i class="fa-solid fa-calendar-week me-1"></i> Xem Thời Khóa Biểu Tuần
            </a>
            <a asp-controller="Program" asp-action="Index" asp-route-authRole="Student" class="btn btn-outline-primary fw-semibold">
                <i class="fa-solid fa-plus me-1"></i> Đăng ký thêm khóa học
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fa-solid fa-folder-open fs-1 mb-3 text-info"></i>
            <h5>Bạn chưa đăng ký khóa học nào!</h5>
            <p class="text-muted">Hãy tham khảo danh sách các chương trình đào tạo để chọn khóa học phù hợp.</p>
            <a asp-controller="Program" asp-action="Index" asp-route-authRole="Student" class="btn btn-primary-custom mt-2">Xem danh sách khóa học</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var reg in Model)
            {
                @if (reg.ClassId == null || reg.Class == null) {
                    <div class="col-lg-6"><div class="card p-4 h-100"><span class="badge @(reg.Status == "Cancelled" ? "bg-secondary" : "bg-warning text-dark") align-self-start">@(reg.Status == "Cancelled" ? "Đã hủy" : "Chờ Admin xếp lớp")</span><h4 class="mt-3">@reg.Program.ProgramName</h4><p>Đơn #REG-@reg.RegistrationId · @reg.RegistrationDate.ToString("dd/MM/yyyy")</p>
                    @await Html.PartialAsync("_EnrollmentPreferences", reg)
                    <p class="mt-3">Trung tâm sẽ xếp lớp theo lịch bạn đã gửi. Lịch chính thức sẽ xuất hiện tại đây sau khi Admin xác nhận.</p>
                    @await Html.PartialAsync("_RegistrationPayment", reg)
                    </div></div>
                    continue;
                }
                <div class="col-lg-6">
                    <div class="card card-custom p-4 border-0 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge @(reg.Status == "Confirmed" ? "bg-success" : reg.Status == "Pending" ? "bg-warning text-dark" : "bg-danger") px-3 py-2 rounded-pill">
                                    @(reg.Status == "Confirmed" ? "Đã xếp lớp" : reg.Status == "Pending" ? "Chờ xếp lớp" : "Đã hủy")
                                </span>
                                <h4 class="fw-bold mt-2 mb-1">@reg.Class.ClassName</h4>
                                <div class="text-primary small fw-semibold">@reg.Program.ProgramName</div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border">@reg.Class.Room</span>
                            </div>
                        </div>

                        <div class="border-top border-bottom py-3 my-2 small">
                            <div class="mb-2">
                                <i class="fa-solid fa-user-tie me-2 text-muted"></i> Giảng viên chính thức: 
                                <strong class="text-primary">@(reg.Class.Teacher != null ? reg.Class.Teacher.UserAccount.FullName : "Đang được Admin điều phối")</strong>
                            </div>
                            @if (reg.DesiredTeacher != null)
                            {
                                <div class="mb-2 text-muted small">
                                    <i class="fa-solid fa-heart text-danger me-2"></i> Giảng viên bạn mong muốn: 
                                    <strong>@reg.DesiredTeacher.UserAccount.FullName</strong>
                                    @if (reg.Class.TeacherId == reg.DesiredTeacherId)
                                    {
                                        <span class="badge bg-success-subtle text-success ms-1">Đã được xếp đúng nguyện vọng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning ms-1">Đang chờ Admin xếp</span>
                                    }
                                </div>
                            }
                            <div class="mb-2">
                                <i class="fa-regular fa-calendar-days me-2 text-muted"></i> Thời gian: 
                                <strong>@reg.Class.StartDate.ToString("dd/MM/yyyy")</strong> đến <strong>@reg.Class.EndDate.ToString("dd/MM/yyyy")</strong>
                            </div>
                            <div>
                                <i class="fa-regular fa-clock me-2 text-muted"></i> Lịch học trong tuần:
                                @if (reg.Class.Schedules.Any())
                                {
                                    <span class="badge bg-secondary-subtle text-dark ms-1">
                                        @string.Join(", ", reg.Class.Schedules.Select(s => $"T{(s.DayOfWeek == 8 ? "CN" : s.DayOfWeek.ToString())} ({s.StartTime:hh\\:mm}-{s.EndTime:hh\\:mm})"))
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Cập nhật sau</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <div class="small">
                                Học phí: <strong class="text-danger">@reg.Program.TuitionFee.ToString("N0") VNĐ</strong>
                                @if (reg.Payment != null)
                                {
                                    <span class="badge @(reg.Payment.Status == "Paid" ? "bg-success" : "bg-warning text-dark") ms-2">
                                        @(reg.Payment.Status == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                                    </span>
                                }
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold" data-bs-toggle="modal" data-bs-target="#feedbackModal-@reg.ClassId">
                                    <i class="fa-solid fa-star text-warning me-1"></i> Đánh giá
                                </button>
                            </div>
                        </div>

                        @await Html.PartialAsync("_RegistrationPayment", reg)
                        <!-- Modal Đánh giá lớp học -->
                        <div class="modal fade text-start" id="feedbackModal-@reg.ClassId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="SubmitFeedback" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="classId" value="@reg.ClassId" />
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold">Đánh Giá Khóa Học: @reg.Class.ClassName</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Mức độ hài lòng của bạn</label>
                                                <select name="rating" class="form-select">
                                                    <option value="5" selected>⭐⭐⭐⭐⭐ - 5 Sao (Rất hài lòng)</option>
                                                    <option value="4">⭐⭐⭐⭐ - 4 Sao (Hài lòng)</option>
                                                    <option value="3">⭐⭐⭐ - 3 Sao (Bình thường)</option>
                                                    <option value="2">⭐⭐ - 2 Sao (Chưa hài lòng)</option>
                                                    <option value="1">⭐ - 1 Sao (Kém)</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Ý kiến nhận xét & góp ý <span class="text-danger">*</span></label>
                                                <textarea name="comment" rows="3" class="form-control" placeholder="Nhận xét về giáo viên, tài liệu hoặc trải nghiệm học tập..." required></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                            <button type="submit" class="btn btn-primary-custom fw-bold">Gửi Đánh Giá</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
