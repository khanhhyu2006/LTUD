@model WedEnglishApp.ViewModels.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
    var authRole = Context.Request.Query["authRole"].ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card card-custom p-4 border-0 bg-white">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-key me-2 text-primary"></i> Đổi Mật Khẩu</h4>
                <form asp-action="ChangePassword" asp-route-authRole="@authRole" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" class="form-control" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold">
                        Lưu Mật Khẩu Mới
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
