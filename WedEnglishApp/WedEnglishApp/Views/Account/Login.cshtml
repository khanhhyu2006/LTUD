@model WedEnglishApp.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card card-custom p-4 border-0 bg-white shadow-sm">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 text-primary mb-2">
                        <i class="fa-solid fa-right-to-bracket fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Đăng Nhập Hệ Thống</h3>
                    <p class="text-muted small">Cổng thông tin dành cho Học viên, Giáo viên và Quản trị viên</p>
                    <p class="text-muted small mb-0">Mỗi vai trò có thể đăng nhập riêng trong một tab trình duyệt.</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email tài khoản</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="admin@englishcenter.edu.vn / hocvien1@gmail.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>
                        <a href="javascript:alert('Vui lòng liên hệ Giáo vụ hoặc Admin để đặt lại mật khẩu.')" class="small text-decoration-none text-primary">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold mb-3">
                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Đăng Nhập
                    </button>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản học viên? 
                        <a asp-action="Register" class="fw-bold text-primary text-decoration-none">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
