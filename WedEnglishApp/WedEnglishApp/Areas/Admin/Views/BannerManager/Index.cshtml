@model List<WedEnglishApp.Models.Banner>
@{
    ViewData["Title"] = "Quản Lý Banner Quảng Bá";
    Layout = "_AdminLayout";
}

<div class="container-fluid p-4">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-images text-primary me-2"></i> Quản Lý Banner Trang Chủ
            </h4>
            <p class="text-muted small mb-0">Cấu hình các slide hình ảnh, tiêu đề, nút bấm và liên kết điều hướng (LinkUrl) trên trang chủ.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold px-4 py-2 rounded-3 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm Banner Mới
        </a>
    </div>

    <!-- Alert thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bảng danh sách Banner -->
    <div class="admin-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase fw-bold">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Thứ tự</th>
                        <th style="width: 140px;">Hình ảnh</th>
                        <th>Tiêu đề & Mô tả</th>
                        <th>Liên kết đích (LinkUrl)</th>
                        <th>Nút bấm (CTA)</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-end pe-4" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.DisplayOrder</td>
                                <td>
                                    <img src="@item.ImageUrl" alt="@item.Title" class="rounded-3 shadow-sm border" style="width: 120px; height: 60px; object-fit: cover;" onerror="this.src='/images/default-banner.png'" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="text-muted small text-truncate" style="max-width: 320px;">@item.Subtitle</div>
                                </td>
                                <td>
                                    <a href="@item.LinkUrl" target="_blank" class="badge bg-light text-primary border text-decoration-none px-2 py-1">
                                        <i class="fa-solid fa-link me-1"></i> @item.LinkUrl
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark px-2 py-1">
                                        @item.ButtonText
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="ToggleActive" asp-route-id="@item.BannerId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-success" : "btn-secondary") rounded-pill px-3 py-1 fw-semibold" title="Click để Bật/Tắt">
                                            @(item.IsActive ? "Đang hiện" : "Tạm ẩn")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.BannerId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.BannerId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa banner này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa banner">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-image fa-3x mb-3 text-secondary opacity-50"></i>
                                <div>Chưa có Banner nào được tạo. Nhấp "Thêm Banner Mới" để tạo slide quảng bá đầu tiên.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
