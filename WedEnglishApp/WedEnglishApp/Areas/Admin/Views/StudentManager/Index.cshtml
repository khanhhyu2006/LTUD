@model List<WedEnglishApp.Models.Student>
@{
    ViewData["Title"] = "Quản Lý Học Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Danh Sách Học Viên Trung Tâm</h3>
        <p class="text-muted small mb-0">Theo dõi thông tin học viên, số lượng khóa học đã đăng ký và trạng thái tài khoản</p>
    </div>
</div>

<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Ảnh / Họ và Tên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Địa Chỉ</th>
                    <th>Số Khóa Học ĐK</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(s.PhotoUrl ?? s.UserAccount.AvatarUrl ?? "/images/default-avatar.png")" alt="Ảnh @s.UserAccount.FullName" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold text-dark">@s.UserAccount.FullName</div>
                                    <div class="small text-muted">ID: #STU-@s.StudentId</div>
                                </div>
                            </div>
                        </td>
                        <td>@s.UserAccount.Email</td>
                        <td>@(s.PhoneNumber ?? "---")</td>
                        <td class="small text-muted">@(s.Address ?? "---")</td>
                        <td>
                            <span class="badge bg-primary">@s.Registrations.Count lớp</span>
                        </td>
                        <td>
                            <span class="badge @(s.UserAccount.IsActive ? "bg-success" : "bg-danger")">
                                @(s.UserAccount.IsActive ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa thông tin">
                                <i class="fa-solid fa-pen-to-square"></i> Sửa
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@s.StudentId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(s.UserAccount.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    <i class="fa-solid @(s.UserAccount.IsActive ? "fa-lock" : "fa-lock-open") me-1"></i>
                                    @(s.UserAccount.IsActive ? "Khóa TK" : "Mở TK")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
