@model WedEnglishApp.Models.Student
@{
    ViewData["Title"] = "Chỉnh Sửa Thông Tin Học Viên";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card p-4">
            <h4 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-user-pen me-2"></i> Chỉnh Sửa Thông Tin Học Viên</h4>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.StudentId" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3 d-flex align-items-center gap-3">
                    <img src="@(Model.PhotoUrl ?? Model.UserAccount.AvatarUrl ?? "/images/default-avatar.png")" alt="Ảnh học viên" class="rounded-circle border" style="width: 72px; height: 72px; object-fit: cover;" />
                    <div class="flex-grow-1">
                        <label for="photo" class="form-label fw-semibold">Thay ảnh hồ sơ học viên</label>
                        <input type="file" id="photo" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG, PNG hoặc WEBP, tối đa 5 MB.</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Họ và Tên Học Viên <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" value="@Model.UserAccount.FullName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Đăng Nhập</label>
                        <input type="email" class="form-control bg-light" value="@Model.UserAccount.Email" readonly />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Số Điện Thoại</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ngày Sinh</label>
                        <input type="date" name="dateOfBirth" class="form-control" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Địa Chỉ Thường Trú</label>
                    <input type="text" name="address" class="form-control" value="@Model.Address" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
