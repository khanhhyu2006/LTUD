@{
    ViewData["Title"] = "Thêm Giảng Viên Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card p-4">
            <h4 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-user-plus me-2"></i> Thêm Giảng Viên Mới Vào Hệ Thống</h4>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Họ và Tên Giảng Viên <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" placeholder="ThS. Nguyễn Văn A" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Đăng Nhập <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" placeholder="teacher@englishcenter.edu.vn" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mật Khẩu Ban Đầu <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control" value="123456" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Bằng Cấp / Học Vị</label>
                        <input type="text" name="degree" class="form-control" placeholder="Thạc sĩ TESOL, IELTS 8.0..." />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Lĩnh Vực Chuyên Môn</label>
                    <input type="text" name="specialization" class="form-control" placeholder="IELTS Speaking & Writing, Giao tiếp phản xạ..." />
                </div>

                <div class="mb-3">
                    <label for="photo" class="form-label fw-semibold">Ảnh đại diện giáo viên</label>
                    <input type="file" id="photo" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG hoặc WEBP, tối đa 5 MB.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Tiểu Sử & Kinh Nghiệm Giảng Dạy</label>
                    <textarea name="bio" rows="3" class="form-control" placeholder="Giới thiệu kinh nghiệm, chứng chỉ..."></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Tạo Tài Khoản Giáo Viên</button>
                </div>
            </form>
        </div>
    </div>
</div>
