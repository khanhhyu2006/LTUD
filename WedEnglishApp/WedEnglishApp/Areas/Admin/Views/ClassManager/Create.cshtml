@model WedEnglishApp.Models.CourseClass
@{
    ViewData["Title"] = "Mở Lớp Học Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card p-4">
            <h4 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-chalkboard me-2"></i> Mở Lớp Học Mới</h4>
            
            <div class="alert alert-light border small text-muted mb-4">
                <i class="fa-solid fa-circle-info text-primary me-2"></i>
                <strong>Cơ chế tạo lớp:</strong> Khi tạo mới, lớp học <strong>không gắn với giáo viên cụ thể nào chịu trách nhiệm</strong>. Lớp được mở theo chương trình học để tiếp nhận học viên đăng ký. Ban Quản Trị (Admin) sẽ phân bổ giáo viên giảng dạy sau dựa theo số lượng học viên hoặc nguyện vọng khi xếp lớp.
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ClassName" class="form-label fw-semibold">Mã / Tên Lớp Học <span class="text-danger">*</span></label>
                        <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: IELTS-K28-T246" />
                        <span asp-validation-for="ClassName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProgramId" class="form-label fw-semibold">Chương Trình Học <span class="text-danger">*</span></label>
                        <select asp-for="ProgramId" asp-items="ViewBag.Programs" class="form-select">
                            <option value="">-- Chọn chương trình học --</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Room" class="form-label fw-semibold">Phòng Học</label>
                        <input asp-for="Room" class="form-control" placeholder="Ví dụ: Phòng 201 - Cơ sở 1" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxStudents" class="form-label fw-semibold">Sĩ Số Tối Đa</label>
                        <input asp-for="MaxStudents" type="number" class="form-control" value="20" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold">Ngày Khai Giảng</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold">Ngày Bế Giảng</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                @await Html.PartialAsync("_ClassScheduleForm", (WedEnglishApp.ViewModels.Admin.ClassScheduleInput)ViewBag.ScheduleForm)

                <div class="mb-4">
                    <label asp-for="Status" class="form-label fw-semibold">Trạng Thái Lớp</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Planning">Planning (Sắp khai giảng / Đang tuyển sinh)</option>
                        <option value="InProgress">InProgress (Đang học)</option>
                        <option value="Completed">Completed (Đã kết thúc)</option>
                        <option value="Cancelled">Cancelled (Hủy lớp)</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu Lớp Học</button>
                </div>
            </form>
        </div>
    </div>
</div>
