@model List<WedEnglishApp.Models.CourseProgram>
@{
    ViewData["Title"] = "Quản Lý Chương Trình Học";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản Lý Chương Trình Học</h3>
        <p class="text-muted small mb-0">Thêm, sửa, xóa và quản lý trạng thái các chương trình đào tạo</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="fa-solid fa-plus me-1"></i> Thêm Chương Trình Mới
    </a>
</div>

<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã</th>
                    <th>Tên Chương Trình</th>
                    <th>Cấp Độ</th>
                    <th>Thời Lượng</th>
                    <th>Học Phí</th>
                    <th>Số Lớp</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">#@p.ProgramId</td>
                        <td>
                            <div class="fw-bold text-dark">@p.ProgramName</div>
                            <div class="small text-muted text-truncate" style="max-width: 320px;">@p.Description</div>
                        </td>
                        <td>
                            <span class="badge bg-info-subtle text-info border border-info-subtle">@p.Level</span>
                        </td>
                        <td>@p.DurationWeeks tuần</td>
                        <td class="fw-bold text-danger">@p.TuitionFee.ToString("N0") đ</td>
                        <td>
                            <a asp-controller="ClassManager" asp-action="Index" class="badge bg-primary text-decoration-none px-2 py-1" title="Xem các lớp mở">
                                <i class="fa-solid fa-chalkboard me-1"></i> @p.Classes.Count lớp mở
                            </a>
                        </td>
                        <td>
                            <form asp-action="ToggleStatus" asp-route-id="@p.ProgramId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-success" : "btn-secondary") rounded-pill py-0 px-2 small">
                                    @(p.IsActive ? "Kích hoạt" : "Tạm dừng")
                                </button>
                            </form>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-controller="RegistrationAdmin" asp-action="Index" asp-route-programId="@p.ProgramId" class="btn btn-sm btn-outline-info" title="Xem học viên đăng ký khóa này">
                                    <i class="fa-solid fa-users"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.ProgramId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.ProgramId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chương trình này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
