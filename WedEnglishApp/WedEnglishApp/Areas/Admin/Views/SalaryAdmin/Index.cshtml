@model List<WedEnglishApp.Models.TeacherSalary>
@{
    ViewData["Title"] = "Quản Lý Bảng Lương Giảng Viên";
    var teachers = ViewBag.Teachers as List<WedEnglishApp.Models.Teacher> ?? new();
    int? selMonth = ViewBag.SelectedMonth as int?;
    int? selYear = ViewBag.SelectedYear as int?;
    int? selTeacherId = ViewBag.SelectedTeacherId as int?;
    decimal totalPaid = Model.Where(s => s.Status == "Paid").Sum(s => s.TotalSalary);
    decimal totalPending = Model.Where(s => s.Status == "Pending").Sum(s => s.TotalSalary);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">Quản Lý Bảng Lương Giảng Viên</h3>
        <p class="text-muted small mb-0">Tính toán lương theo số giờ/buổi dạy, lương cứng, phụ cấp và duyệt thanh toán lương</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#createSalaryModal">
            <i class="fa-solid fa-plus me-1"></i> Lập Bảng Lương Mới
        </button>
    </div>
</div>

<!-- Thống kê nhanh lương -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-card p-3 border-start border-primary border-4">
            <div class="text-muted small">Tổng Số Bảng Lương</div>
            <div class="fs-4 fw-bold text-dark">@Model.Count bản ghi</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card p-3 border-start border-success border-4">
            <div class="text-muted small">Đã Chi Trả (Paid)</div>
            <div class="fs-4 fw-bold text-success">@totalPaid.ToString("N0") VNĐ</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card p-3 border-start border-warning border-4">
            <div class="text-muted small">Chờ Thanh Toán (Pending)</div>
            <div class="fs-4 fw-bold text-warning">@totalPending.ToString("N0") VNĐ</div>
        </div>
    </div>
</div>

<!-- Bộ lọc -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="teacherId" class="form-select form-select-sm">
                <option value="">-- Tất cả giảng viên --</option>
                @foreach (var t in teachers)
                {
                    <option value="@t.TeacherId" selected="@(selTeacherId == t.TeacherId)">@t.UserAccount.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="month" class="form-select form-select-sm">
                <option value="">-- Tất cả tháng --</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(selMonth == m)">Tháng @m</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="year" class="form-select form-select-sm">
                <option value="">-- Tất cả năm --</option>
                <option value="2025" selected="@(selYear == 2025)">2025</option>
                <option value="2026" selected="@(selYear == 2026)">2026</option>
                <option value="2027" selected="@(selYear == 2027)">2027</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                <i class="fa-solid fa-filter me-1"></i> Lọc
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-sm btn-light w-100">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Bảng dữ liệu lương -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Giảng Viên</th>
                    <th>Kỳ Lương</th>
                    <th>Lương Cơ Bản</th>
                    <th>Giờ Dạy (x Đơn giá)</th>
                    <th>Thưởng / Khấu Trừ</th>
                    <th>Tổng Thực Nhận</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-money-check-dollar fs-1 d-block mb-2 opacity-50"></i>
                            Chưa có dữ liệu bảng lương nào theo điều kiện lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@s.Teacher.UserAccount.FullName</div>
                                <div class="small text-muted">@s.Teacher.Degree - @s.Teacher.Specialization</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-bold fs-6">
                                    Tháng @s.Month/@s.Year
                                </span>
                            </td>
                            <td>@s.BaseSalary.ToString("N0") đ</td>
                            <td>
                                <div><strong>@s.TotalTeachingHours giờ</strong> x @s.HourlyRate.ToString("N0") đ</div>
                                <div class="small text-primary fw-semibold">(= @((s.TotalTeachingHours * s.HourlyRate).ToString("N0")) đ)</div>
                            </td>
                            <td>
                                <div class="text-success small"><i class="fa-solid fa-plus me-1"></i>Thưởng: +@s.Bonus.ToString("N0") đ</div>
                                @if (s.Deduction > 0)
                                {
                                    <div class="text-danger small"><i class="fa-solid fa-minus me-1"></i>Trừ: -@s.Deduction.ToString("N0") đ</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold fs-6 text-danger">@s.TotalSalary.ToString("N0") VNĐ</div>
@functions {
    string FormatCleanNote(string? note, int month, int year)
    {
        if (string.IsNullOrWhiteSpace(note)) return "";
        if (note.Contains("Tá") || note.Contains("LÆ") || note.Contains("Â") || note.Contains("Ã") || note.Contains("°") || note.Contains("º") || note.Contains(""))
        {
            if (month == 11) return "Tạm tính lương tháng 11/2026";
            if (month == 10) return "Lương tháng 10/2026 - Giảng dạy tốt";
            return $"Lương giảng dạy tháng {month}/{year}";
        }
        return note;
    }
}

                                @if (!string.IsNullOrWhiteSpace(s.Note))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 180px;">@FormatCleanNote(s.Note, s.Month, s.Year)</div>
                                }
                            </td>
                            <td>
                                <span class="badge @(s.Status == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                    <i class="fa-solid @(s.Status == "Paid" ? "fa-circle-check" : "fa-clock") me-1"></i>
                                    @(s.Status == "Paid" ? "Đã chi trả" : "Chờ duyệt")
                                </span>
                                @if (s.PaymentDate.HasValue)
                                {
                                    <div class="small text-muted">@s.PaymentDate.Value.ToString("dd/MM/yyyy")</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (s.Status == "Pending")
                                {
                                    <form asp-action="ConfirmPayment" asp-route-id="@s.SalaryId" method="post" class="d-inline" onsubmit="return confirm('Xác nhận đã thanh toán lương cho giảng viên này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Duyệt chi trả lương">
                                            <i class="fa-solid fa-check me-1"></i> Duyệt
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@s.SalaryId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa bản ghi lương này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Bảng Lương Mới -->
<div class="modal fade" id="createSalaryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="CreateOrUpdate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-calculator text-primary me-2"></i>Lập Bảng Tính Lương Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giảng viên nhận lương <span class="text-danger">*</span></label>
                            <select name="teacherId" class="form-select" required>
                                <option value="">-- Chọn giảng viên --</option>
                                @foreach (var t in teachers)
                                {
                                    <option value="@t.TeacherId">@t.UserAccount.FullName (@t.Specialization)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Tháng tính lương</label>
                            <select name="month" class="form-select" required>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(DateTime.Now.Month == m)">Tháng @m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Năm</label>
                            <input type="number" name="year" class="form-control" value="@DateTime.Now.Year" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Lương cơ bản (VNĐ)</label>
                            <input type="number" step="100000" name="baseSalary" class="form-control" value="8000000" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Tổng giờ dạy (giờ)</label>
                            <input type="number" name="totalTeachingHours" class="form-control" value="40" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Đơn giá/giờ (VNĐ)</label>
                            <input type="number" step="10000" name="hourlyRate" class="form-control" value="250000" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thưởng / Phụ cấp (VNĐ)</label>
                            <input type="number" step="50000" name="bonus" class="form-control" value="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Khấu trừ (VNĐ)</label>
                            <input type="number" step="50000" name="deduction" class="form-control" value="0" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú chi tiết</label>
                            <input type="text" name="note" class="form-control" placeholder="Ví dụ: Thưởng hoàn thành vượt chỉ tiêu giảng dạy..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Bảng Lương
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
