@model List<WedEnglishApp.Models.CourseClass>
@{
    ViewData["Title"] = "Lịch Dạy & Thời Khóa Biểu Giảng Viên";
    var assignedTests = ViewBag.AssignedTests as List<WedEnglishApp.Models.PlacementTest> ?? new();
    int weekOffset = ViewBag.WeekOffset != null ? (int)ViewBag.WeekOffset : 0;
    DateTime startOfWeek = ViewBag.StartOfWeek != null ? (DateTime)ViewBag.StartOfWeek : DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1);
    DateTime endOfWeek = ViewBag.EndOfWeek != null ? (DateTime)ViewBag.EndOfWeek : startOfWeek.AddDays(6);

    var dayNames = new Dictionary<int, string>
    {
        { 2, "Thứ Hai" },
        { 3, "Thứ Ba" },
        { 4, "Thứ Tư" },
        { 5, "Thứ Năm" },
        { 6, "Thứ Sáu" },
        { 7, "Thứ Bảy" },
        { 8, "Chủ Nhật" }
    };
    int totalSessions = Model.Sum(c => c.Schedules.Count);
    int totalStudents = Model.Sum(c => c.Registrations.Count);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-calendar-week text-success me-2"></i> Lịch Dạy & Thời Khóa Biểu</h3>
        <p class="text-muted small mb-0">Theo dõi chi tiết các ca giảng dạy và lịch khảo thí chấm thi do Admin phân công theo ngày cụ thể</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
            <i class="fa-solid fa-chalkboard me-1"></i> Danh sách lớp dạy
        </a>
        <a asp-controller="TeacherTest" asp-action="Index" class="btn btn-success fw-semibold">
            <i class="fa-solid fa-pen-nib me-1"></i> Chấm thi xếp lớp (@assignedTests.Count(t => t.Status != "Completed"))
        </a>
    </div>
</div>

<!-- Thống kê ca dạy & ca thi -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="teacher-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-chalkboard fs-4"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Lớp phụ trách</div>
                <div class="fs-4 fw-bold text-dark">@Model.Count lớp</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="teacher-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-regular fa-clock fs-4"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Tổng ca dạy / tuần</div>
                <div class="fs-4 fw-bold text-dark">@totalSessions ca / tuần</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="teacher-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-clipboard-check fs-4"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Ca thi khảo thí</div>
                <div class="fs-4 fw-bold text-dark">@assignedTests.Count ca thi</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="teacher-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-users fs-4"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Tổng học viên</div>
                <div class="fs-4 fw-bold text-dark">@totalStudents học viên</div>
            </div>
        </div>
    </div>
</div>

<!-- THANH ĐIỀU HƯỚNG THEO TUẦN / NGÀY THÁNG NĂM CỤ THỂ -->
<div class="teacher-card p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Schedule" asp-route-weekOffset="@(weekOffset - 1)" class="btn btn-outline-success btn-sm rounded-pill px-3">
                <i class="fa-solid fa-chevron-left me-1"></i> Tuần trước
            </a>
            @if (weekOffset != 0)
            {
                <a asp-action="Schedule" asp-route-weekOffset="0" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-rotate-right me-1"></i> Tuần hiện tại
                </a>
            }
            <a asp-action="Schedule" asp-route-weekOffset="@(weekOffset + 1)" class="btn btn-outline-success btn-sm rounded-pill px-3">
                Tuần tới <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
        </div>
        <div class="text-center">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill">
                <i class="fa-regular fa-calendar-days me-1"></i>
                Tuần: <strong>@startOfWeek.ToString("dd/MM/yyyy")</strong> - <strong>@endOfWeek.ToString("dd/MM/yyyy")</strong>
            </span>
        </div>
        <div class="text-muted small">
            <i class="fa-solid fa-circle-check text-success me-1"></i> Thời khóa biểu ngày tháng thực tế
        </div>
    </div>
</div>

<!-- KHỐI LỊCH THI / COI THI KHẢO THÍ ADMIN ĐÃ PHÂN CÔNG -->
@if (assignedTests.Any())
{
    <div class="teacher-card p-4 mb-4 border-start border-info border-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-clipboard-user text-info me-2"></i> Lịch Khảo Thí & Chấm Điểm Được Admin Phân Công
            </h5>
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1 rounded-pill">
                @assignedTests.Count ca khảo thí
            </span>
        </div>
        <div class="row g-3">
            @foreach (var pt in assignedTests)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 rounded-3 border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary px-2 py-1">#TEST-@pt.TestId</span>
                            <span class="badge @(pt.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                @(pt.Status == "Completed" ? "Đã chấm điểm" : "Chờ chấm điểm")
                            </span>
                        </div>
                        <div class="fw-bold text-dark fs-6 mb-1">Học viên: @pt.Student.UserAccount.FullName</div>
                        <div class="small text-danger fw-semibold mb-1">
                            <i class="fa-regular fa-calendar-days me-1"></i> @pt.TestDate.ToString("dd/MM/yyyy") - @pt.TestTime
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="fa-solid fa-door-open me-1 text-primary"></i> Phòng thi: 
                            <strong class="text-dark">@(string.IsNullOrEmpty(pt.Room) ? "Phòng Khảo Thí 101" : pt.Room)</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2">
                            <span class="small text-muted">Email: @pt.Student.UserAccount.Email</span>
                            @if (pt.Status != "Completed")
                            {
                                <a asp-controller="TeacherTest" asp-action="Index" class="btn btn-sm btn-primary py-0 px-2 small">
                                    <i class="fa-solid fa-pen-nib me-1"></i> Chấm điểm
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-success small">@pt.Score điểm</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (!Model.Any(c => c.Schedules.Any()) && !assignedTests.Any())
{
    <div class="alert alert-info text-center py-5 rounded-4 shadow-sm">
        <i class="fa-solid fa-calendar-xmark fs-1 mb-3 text-info"></i>
        <h5>Hiện chưa có ca dạy hoặc ca thi nào được xếp lịch!</h5>
        <p class="text-muted mb-0">Ban Quản Trị đang tiến hành phân bổ lịch dạy cho các lớp bạn phụ trách.</p>
    </div>
}
else
{
    <!-- Lưới Thời Khóa Biểu Giảng Dạy Tuần Theo Ngày Tháng Năm Cụ Thể -->
    <div class="row g-3 mb-5">
        @for (int dayIndex = 0; dayIndex < 7; dayIndex++)
        {
            DateTime dayDate = startOfWeek.AddDays(dayIndex);
            int scheduleDayOfWeek = dayIndex == 6 ? 8 : (dayIndex + 2); // 0 (Mon) -> 2, 6 (Sun) -> 8

            // Ca dạy của lớp trong ngày cụ thể này
            var dayClasses = Model
                .Where(c => c.StartDate.Date <= dayDate.Date && dayDate.Date <= c.EndDate.Date)
                .SelectMany(c => c.Schedules.Where(s => s.DayOfWeek == scheduleDayOfWeek).Select(s => new { Schedule = s, Class = c, Program = c.Program }))
                .OrderBy(x => x.Schedule.StartTime)
                .ToList();

            // Ca khảo thí/coi thi do Admin phân công đúng ngày này
            var dayTests = assignedTests
                .Where(t => t.TestDate.Date == dayDate.Date)
                .OrderBy(t => t.TestTime)
                .ToList();

            bool isToday = dayDate.Date == DateTime.Today;
            bool hasEvents = dayClasses.Any() || dayTests.Any();

            <div class="col-lg col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 bg-white overflow-hidden @(isToday ? "border border-2 border-success" : "")">
                    <div class="p-3 text-center @(hasEvents ? "bg-success text-white" : "bg-light text-muted border-bottom")">
                        <h6 class="fw-bold mb-0">@dayNames[scheduleDayOfWeek]</h6>
                        <div class="x-small @(hasEvents ? "text-white" : "text-success fw-semibold")">
                            @dayDate.ToString("dd/MM/yyyy")
                        </div>
                        <span class="x-small @(hasEvents ? "text-white-50" : "text-muted")">
                            @(hasEvents ? $"{dayClasses.Count + dayTests.Count} ca" : "Nghỉ")
                        </span>
                    </div>
                    <div class="p-3 d-flex flex-column gap-2 flex-grow-1">
                        @if (!hasEvents)
                        {
                            <div class="text-center text-muted small my-auto py-3 opacity-50">
                                <i class="fa-regular fa-circle-check d-block mb-1"></i> Trống lịch
                            </div>
                        }
                        else
                        {
                            <!-- Ca coi thi khảo thí đúng ngày này -->
                            @foreach (var pt in dayTests)
                            {
                                <div class="p-2 rounded-3 border border-info bg-info-subtle small mb-1 shadow-sm">
                                    <div class="badge bg-info text-dark w-100 mb-1 py-1 fw-bold">
                                        <i class="fa-solid fa-pen-nib me-1"></i> CA KHẢO THÍ: @pt.TestTime
                                    </div>
                                    <div class="fw-bold text-dark text-truncate">@pt.Student.UserAccount.FullName</div>
                                    <div class="x-small text-danger fw-semibold">
                                        <i class="fa-solid fa-door-open me-1"></i> @(string.IsNullOrEmpty(pt.Room) ? "Phòng Khảo Thí 101" : pt.Room)
                                    </div>
                                    <div class="x-small text-muted">#TEST-@pt.TestId</div>
                                </div>
                            }

                            <!-- Ca giảng dạy của lớp đúng ngày này -->
                            @foreach (var item in dayClasses)
                            {
                                <div class="p-2 rounded-3 border bg-light small">
                                    <div class="badge bg-success-subtle text-success border border-success-subtle w-100 mb-1 py-1">
                                        <i class="fa-regular fa-clock me-1"></i> @item.Schedule.StartTime.ToString(@"hh\:mm") - @item.Schedule.EndTime.ToString(@"hh\:mm")
                                    </div>
                                    <div class="fw-bold text-dark text-truncate" title="@item.Class.ClassName">@item.Class.ClassName</div>
                                    <div class="text-muted x-small text-truncate mb-1">@item.Program.ProgramName</div>
                                    <div class="d-flex justify-content-between align-items-center x-small text-secondary border-top pt-1">
                                        <span><i class="fa-solid fa-door-open me-1"></i> Phòng @item.Class.Room</span>
                                        <span><i class="fa-solid fa-users me-1"></i> @item.Class.Registrations.Count HV</span>
                                    </div>
                                    <div class="mt-1">
                                        <a asp-action="Students" asp-route-id="@item.Class.ClassId" class="btn btn-outline-success btn-sm w-100 py-0" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-user-group me-1"></i> Danh sách lớp
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bảng danh sách chi tiết các lớp đang phụ trách -->
    <div class="teacher-card p-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="fa-solid fa-clipboard-list text-success me-2"></i> Chi Tiết Lớp Đang Giảng Dạy
        </h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên Lớp Học</th>
                        <th>Chương Trình</th>
                        <th>Phòng Học</th>
                        <th>Lịch Học Trong Tuần</th>
                        <th>Sĩ Số</th>
                        <th>Thời Gian Khóa</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@c.ClassName</td>
                            <td>@c.Program.ProgramName</td>
                            <td><span class="badge bg-light text-dark border">@c.Room</span></td>
                            <td>
                                @if (c.Schedules.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var s in c.Schedules.OrderBy(x => x.DayOfWeek))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                @(s.DayOfWeek == 8 ? "CN" : $"T{s.DayOfWeek}") (@s.StartTime.ToString(@"hh\:mm")-@s.EndTime.ToString(@"hh\:mm"))
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa xếp ca</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-user me-1"></i> @c.Registrations.Count / @c.MaxStudents
                                </span>
                            </td>
                            <td class="small text-muted">
                                @c.StartDate.ToString("dd/MM/yyyy") - @c.EndDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <a asp-action="Students" asp-route-id="@c.ClassId" class="btn btn-outline-success btn-sm">
                                    <i class="fa-solid fa-user-graduate me-1"></i> Học viên
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
