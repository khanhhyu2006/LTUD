@model WedEnglishApp.Models.CourseClass
@{
    ViewData["Title"] = "Danh Sách Học Viên Lớp " + Model.ClassName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Danh Sách Học Viên: @Model.ClassName</h3>
        <p class="text-muted small mb-0">Khóa: <strong>@Model.Program.ProgramName</strong> | Phòng: <strong>@Model.Room</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách lớp
    </a>
</div>

<div class="teacher-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã HV</th>
                    <th>Ảnh hồ sơ</th>
                    <th>Họ và Tên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Ngày Đăng Ký</th>
                    <th>Điểm Danh Buổi Học</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registrations.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Lớp học hiện tại chưa có học viên đăng ký.</td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model.Registrations)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#STU-@r.Student.StudentId</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.Student.PhotoUrl ?? r.Student.UserAccount.AvatarUrl))
                                {
                                    <img src="@(r.Student.PhotoUrl ?? r.Student.UserAccount.AvatarUrl)" alt="Ảnh @r.Student.UserAccount.FullName" class="rounded-circle" style="width: 44px; height: 44px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có ảnh</span>
                                }
                            </td>
                            <td class="fw-bold text-dark">@r.Student.UserAccount.FullName</td>
                            <td>@r.Student.UserAccount.Email</td>
                            <td>@(r.Student.PhoneNumber ?? "---")</td>
                            <td class="small text-muted">@r.RegistrationDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="att-@r.RegistrationId" checked />
                                    <label class="form-check-label small" for="att-@r.RegistrationId">Có mặt</label>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
