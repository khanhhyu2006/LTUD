@model List<WedEnglishApp.Models.CourseClass>
@{
    ViewData["Title"] = "Các Lớp Tôi Giảng Dạy";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">Các Lớp Giảng Dạy Của Tôi</h3>
        <p class="text-muted small mb-0">Theo dõi lịch học, phòng học và sĩ số các lớp đang phụ trách</p>
    </div>
    <a asp-action="Schedule" class="btn btn-success fw-semibold">
        <i class="fa-solid fa-calendar-week me-1"></i> Xem Thời Khóa Biểu Giảng Dạy
    </a>
</div>

<div class="teacher-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Tên Lớp Học</th>
                    <th>Chương Trình</th>
                    <th>Phòng Học</th>
                    <th>Lịch Học</th>
                    <th>Sĩ Số</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-dark">@c.ClassName</td>
                        <td>@c.Program.ProgramName</td>
                        <td><span class="badge bg-light text-dark border">@c.Room</span></td>
                        <td class="small">
                            @if (c.Schedules.Any())
                            {
                                @string.Join(", ", c.Schedules.Select(s => $"T{(s.DayOfWeek == 8 ? "CN" : s.DayOfWeek.ToString())} ({s.StartTime:hh\\:mm}-{s.EndTime:hh\\:mm})"))
                            }
                        </td>
                        <td>
                            <span class="badge bg-success px-2 py-1">@c.Registrations.Count / @c.MaxStudents</span>
                        </td>
                        <td>
                            <span class="badge @(c.Status == "Planning" ? "bg-warning text-dark" : "bg-success")">@c.Status</span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Students" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-success">
                                <i class="fa-solid fa-users me-1"></i> Xem Học Viên
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
