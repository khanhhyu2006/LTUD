@model List<WedEnglishApp.Models.TeacherSalary>
@{
    ViewData["Title"] = "Bảng Lương & Thu Nhập Của Tôi";
    decimal totalIncome = Model.Where(s => s.Status == "Paid").Sum(s => s.TotalSalary);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-money-check-dollar text-success me-2"></i> Thu Nhập & Bảng Lương</h3>
        <p class="text-muted small mb-0">Theo dõi chi tiết số giờ dạy, lương cơ bản, phụ cấp thưởng và trạng thái chi trả lương</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
            <i class="fa-solid fa-wallet me-1"></i> Tổng đã nhận: @totalIncome.ToString("N0") VNĐ
        </span>
    </div>
</div>

<div class="teacher-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Kỳ Lương</th>
                    <th>Lương Cơ Bản</th>
                    <th>Số Giờ Dạy</th>
                    <th>Đơn Giá / Giờ</th>
                    <th>Thưởng / Phụ Cấp</th>
                    <th>Khấu Trừ</th>
                    <th>Thực Lĩnh</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fs-1 d-block mb-2 opacity-50"></i>
                            Chưa có bảng tính lương nào được lập cho tài khoản của bạn.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                <span class="badge bg-light text-dark border fs-6">Tháng @s.Month/@s.Year</span>
                            </td>
                            <td>@s.BaseSalary.ToString("N0") đ</td>
                            <td><strong class="text-primary">@s.TotalTeachingHours giờ</strong></td>
                            <td>@s.HourlyRate.ToString("N0") đ</td>
                            <td class="text-success">+@s.Bonus.ToString("N0") đ</td>
                            <td class="text-danger">-@s.Deduction.ToString("N0") đ</td>
                            <td>
                                <div class="fw-bold fs-6 text-danger">@s.TotalSalary.ToString("N0") VNĐ</div>
@functions {
    string FormatCleanNote(string? note, int month, int year)
    {
        if (string.IsNullOrWhiteSpace(note)) return "";
        if (note.Contains("Tá") || note.Contains("LÆ") || note.Contains("Â") || note.Contains("Ã") || note.Contains("°") || note.Contains("º") || note.Contains(""))
        {
            if (month == 11) return "Tạm tính lương tháng 11/2026";
            if (month == 10) return "Lương tháng 10/2026 - Giảng dạy tốt";
            return $"Lương giảng dạy tháng {month}/{year}";
        }
        return note;
    }
}

                                @if (!string.IsNullOrWhiteSpace(s.Note))
                                {
                                    <div class="small text-muted">@FormatCleanNote(s.Note, s.Month, s.Year)</div>
                                }
                            </td>
                            <td>
                                <span class="badge @(s.Status == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                    <i class="fa-solid @(s.Status == "Paid" ? "fa-circle-check" : "fa-clock") me-1"></i>
                                    @(s.Status == "Paid" ? "Đã nhận tiền" : "Chờ chi trả")
                                </span>
                                @if (s.PaymentDate.HasValue)
                                {
                                    <div class="small text-muted mt-1">@s.PaymentDate.Value.ToString("dd/MM/yyyy")</div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
